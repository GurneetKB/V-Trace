{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "V-Trace: Streamlit app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "V-Trace: build index from data/videos",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_index.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "V-Trace: evaluate the Re-ID model on VeRi-776",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/eval_veri.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "V-Trace: make sample smoke-test videos",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/make_sample_videos.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
